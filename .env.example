# ═══════════════════════════════════════════════════════════════
# ONE two HOA — Environment Variables
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Stripe (owner payments and postage only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Chargebee (ONE two subscription billing) ────────────────
CHARGEBEE_SITE=onetwo-test
CHARGEBEE_API_KEY=test_...
CHARGEBEE_WEBHOOK_USER=onetwo
CHARGEBEE_WEBHOOK_PASS=
VITE_CB_SITE=onetwo-test
VITE_CB_PRICE_SELF_MANAGED_MONTHLY=Self-Managed-USD-Monthly
VITE_CB_PRICE_SELF_MANAGED_ANNUAL=Self-Managed-USD-Annual
VITE_CB_PRICE_FACILITIES_MONTHLY=Facilities-USD-Monthly
VITE_CB_PRICE_FACILITIES_ANNUAL=Facilities-USD-Annual
VITE_CB_PRICE_ONCALL_SM_MONTHLY=OnCall-SM-USD-Monthly
VITE_CB_PRICE_ONCALL_SM_ANNUAL=OnCall-SM-USD-Annual
VITE_CB_PRICE_ONCALL_FAC_MONTHLY=OnCall-Fac-USD-Monthly
VITE_CB_PRICE_ONCALL_FAC_ANNUAL=OnCall-Fac-USD-Annual
VITE_CB_PRICE_PM_SEAT_MONTHLY=PM-Seat-USD-Monthly
VITE_CB_PRICE_PM_SEAT_ANNUAL=PM-Seat-USD-Annual
VITE_CB_PRICE_SETUP_SM=Setup-SM-USD
VITE_CB_PRICE_SETUP_FAC=Setup-Fac-USD

# ═══════════════════════════════════════════════════════════════
# Supabase Edge Function Secrets (set via supabase secrets set)
# These are NOT committed to the repo — set them in Supabase Dashboard
# or via CLI: supabase secrets set CHARGEBEE_SITE=onetwo-test ...
# ═══════════════════════════════════════════════════════════════

# CHARGEBEE_SITE=onetwo-test
# CHARGEBEE_API_KEY=test_...
# CHARGEBEE_WEBHOOK_USER=onetwo
# CHARGEBEE_WEBHOOK_PASS=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://app.getonetwo.com
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (auto-set by Supabase for Edge Functions)
