# ═══════════════════════════════════════════════════════════════
# ONE two HOA — Environment Variables
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── Chargebee (ONE two subscription billing) ────────────────
CHARGEBEE_SITE=getonetwo-test
CHARGEBEE_API_KEY=test_...
CHARGEBEE_WEBHOOK_USER=onetwo
CHARGEBEE_WEBHOOK_PASS=
VITE_CB_SITE=getonetwo-test
# Publishable key for the signup page's payment fields (Chargebee → Settings →
# Configure Chargebee → API Keys → Publishable key). Safe to ship to the
# browser; the full-access API key above never leaves the edge functions.
VITE_CB_PUBLISHABLE_KEY=test_...
# Item price ids are not configured here: they live with the prices in
# supabase/functions/_shared/checkoutPricing.ts.

# ── Ad measurement ────────────────────────────────────────────
# Reddit Ads pixel ID (Reddit Ads → Events Manager). The Reddit pixel and its
# SignUp conversion stay off until this is set.
VITE_REDDIT_PIXEL_ID=

# ═══════════════════════════════════════════════════════════════
# Supabase Edge Function Secrets (set via supabase secrets set)
# These are NOT committed to the repo — set them in Supabase Dashboard
# or via CLI: supabase secrets set CHARGEBEE_SITE=getonetwo-test ...
# ═══════════════════════════════════════════════════════════════

# CHARGEBEE_SITE=getonetwo-test
# CHARGEBEE_API_KEY=test_...
# CHARGEBEE_WEBHOOK_USER=onetwo
# CHARGEBEE_WEBHOOK_PASS=
# STRIPE_SECRET_KEY=sk_test_...          (owner payments via Stripe Connect)
# STRIPE_WEBHOOK_SECRET=whsec_...
# DOCUPOST_API_URL=                      (optional override; defaults to DocuPost's sendletter endpoint)
# LETTERSTREAM_PARTNER_URL=https://...   (our LetterStream Partnership-mode sign-up link; each building opens its own account through it)
# LETTERSTREAM_API_URL=                  (optional override; defaults to LetterStream's production API)
# LETTERSTREAM_PORTAL_URL=               (optional override; defaults to https://secure.letterstream.com/)
# SITE_URL=https://app.getonetwo.com
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (auto-set by Supabase for Edge Functions)
