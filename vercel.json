{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://js.chargebee.com https://cdn.mxpnl.com https://browser.sentry-cdn.com https://bzrcdn.openai.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://api.stripe.com https://*.chargebee.com https://api-js.mixpanel.com https://cdn.mxpnl.com https://*.ingest.us.sentry.io https://bzrcdn.openai.com https://*.openai.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; frame-src https://js.stripe.com https://js.chargebee.com https://*.chargebee.com https://www.googletagmanager.com https://td.doubleclick.net; font-src 'self' https://fonts.gstatic.com"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/app.html" },
    { "source": "/signup", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/home", "destination": "/app.html" },
    { "source": "/setup", "destination": "/app.html" },
    { "source": "/obligations/:path*", "destination": "/app.html" },
    { "source": "/funds", "destination": "/app.html" },
    { "source": "/financial", "destination": "/app.html" },
    { "source": "/issues", "destination": "/app.html" },
    { "source": "/building", "destination": "/app.html" },
    { "source": "/compliance", "destination": "/app.html" },
    { "source": "/archives", "destination": "/app.html" },
    { "source": "/voting", "destination": "/app.html" },
    { "source": "/boardroom", "destination": "/app.html" },
    { "source": "/community", "destination": "/app.html" },
    { "source": "/my-unit", "destination": "/app.html" },
    { "source": "/my-unit/:path*", "destination": "/app.html" },
    { "source": "/account", "destination": "/app.html" },
    { "source": "/support", "destination": "/app.html" },
    { "source": "/subscription", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/portfolio/:path*", "destination": "/app.html" },
    { "source": "/portfolio", "destination": "/app.html" },
    { "source": "/association-team", "destination": "/app.html" },
    { "source": "/association-team/:path*", "destination": "/app.html" },
    { "source": "/cases", "destination": "/app.html" },
    { "source": "/cases/:path*", "destination": "/app.html" },
    { "source": "/board-ops/:path*", "destination": "/app.html" },
    { "source": "/property-log", "destination": "/app.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "redirects": [
    { "source": "/demo", "destination": "/", "statusCode": 301 }
  ]
}
