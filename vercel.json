{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com https://cdn.mxpnl.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://api.stripe.com https://api-js.mixpanel.com https://*.ingest.us.sentry.io; frame-src https://js.stripe.com; font-src 'self' https://fonts.gstatic.com"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/financial", "destination": "/app.html" },
    { "source": "/issues", "destination": "/app.html" },
    { "source": "/building", "destination": "/app.html" },
    { "source": "/compliance", "destination": "/app.html" },
    { "source": "/archives", "destination": "/app.html" },
    { "source": "/voting", "destination": "/app.html" },
    { "source": "/boardroom", "destination": "/app.html" },
    { "source": "/community", "destination": "/app.html" },
    { "source": "/my-unit", "destination": "/app.html" },
    { "source": "/account", "destination": "/app.html" },
    { "source": "/support", "destination": "/app.html" },
    { "source": "/subscription", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/portfolio/:path*", "destination": "/app.html" },
    { "source": "/portfolio", "destination": "/app.html" },
    { "source": "/association-team", "destination": "/app.html" },
    { "source": "/association-team/:path*", "destination": "/app.html" },
    { "source": "/demo", "destination": "/demo.html" }
  ]
}
